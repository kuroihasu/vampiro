{
  "name": "vampiro",
  "version": "0.0.0",
  "private": true,
  "description": "Web de Vampiro: la Mascarada (wiki, fichas por edición, salas y dados)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:shared": "pnpm --filter @vampiro/shared build",
    "dev:shared": "pnpm --filter @vampiro/shared dev",
    "dev:api": "pnpm --filter @vampiro/api start:dev",
    "dev:web": "pnpm --filter @vampiro/web start",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
