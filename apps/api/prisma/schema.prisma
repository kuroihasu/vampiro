// Esquema de la Fase 1: usuarios, sesiones (refresh tokens) y wiki.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  displayName   String
  role          Role           @default(user)
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  characters    Character[]
}

/// Refresh token rotado. Solo se guarda el hash SHA-256 del valor que recibe el cliente.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Artículo de la wiki. `traitKey` lo enlaza con un rasgo del ruleset (tooltips).
model WikiArticle {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  title        String
  category     String
  editions     String[]
  traitKey     String?
  bodyMarkdown String
  updatedAt    DateTime @updatedAt

  @@index([category])
}

enum CharacterStatus {
  draft
  complete
}

/// Ficha de personaje. `sheet` es el CharacterSheet de @vampiro/shared; `clan` lo replica para listar.
/// `updatedAt` hace de versión para el control optimista (PUT).
model Character {
  id             String          @id @default(uuid()) @db.Uuid
  ownerId        String          @db.Uuid
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  edition        String
  rulesetVersion String
  name           String
  concept        String          @default("")
  clan           String?
  status         CharacterStatus @default(draft)
  sheet          Json
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ownerId, edition])
}
