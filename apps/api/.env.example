# Copia este archivo a .env (no se sube al repo) y ajusta los valores.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:4200

# PostgreSQL de docker-compose.yml
DATABASE_URL=postgresql://vampiro:vampiro@localhost:5432/vampiro?schema=public

# Genera secretos propios, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-32-caracteres-o-mas
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
