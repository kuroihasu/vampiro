{
  "name": "@vampiro/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos, rulesets por edición y motor de reglas compartidos entre web y api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
